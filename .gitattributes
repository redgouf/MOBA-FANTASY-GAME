# Normalize line endings for text files Godot reads and writes.
* text=auto eol=lf

*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary assets (add to Git LFS once real art/audio lands).
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.glb binary
*.blend binary
