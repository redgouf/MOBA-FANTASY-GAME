; Engine configuration file.
; Gielinor Legends — an OSRS-themed MOBA prototype.
; Target engine: Godot 4.7.2-stable.

config_version=5

[application]

config/name="Gielinor Legends"
config/description="A 5v5 three-lane MOBA where every champion is an Old School RuneScape gear build."
config/version="0.34.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ModelPack="*res://scripts/autoload/model_pack.gd"
GameData="*res://scripts/autoload/game_data.gd"
Controls="*res://scripts/autoload/controls.gd"
Settings="*res://scripts/autoload/settings.gd"
GameTick="*res://scripts/autoload/game_tick.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="walls"
3d_physics/layer_2="units"
3d_physics/layer_3="ground"

[navigation]

3d/default_cell_size=0.5
3d/default_cell_height=0.25

[rendering]

anti_aliasing/quality/msaa_3d=2
